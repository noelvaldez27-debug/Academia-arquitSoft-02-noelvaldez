# ==============================================================================
# EVALUA-NET — Archivo de ejemplo para variables de entorno (.env.example)
#
# Copia este archivo a .env antes de levantar los contenedores:
#   cp .env.example .env
#
# NUNCA incluyas contraseñas reales ni subas el archivo .env al repositorio.
# Todas las claves aquí presentes son valores de ejemplo para desarrollo local.
# ==============================================================================

# ── Backend / Aplicación ──────────────────────────────────────────────────────
# Entorno de ejecución de Node.js (development, production, test)
NODE_ENV=development

# Puerto HTTP en el que escucha el servidor backend
PORT=3000

# Clave secreta para firmar y verificar tokens de autenticación JWT (AC04, ADR-008)
JWT_SECRET=cambiar_esta_clave_jwt_secreta_en_produccion

# ── PostgreSQL (Persistencia definitiva — RC07, ADR-003) ─────────────────────
# Nombre de la base de datos relacional para EVALUA-NET
POSTGRES_DB=evalua_net

# Usuario de acceso y administración de la base de datos
POSTGRES_USER=usuario_postgres_falso

# Contraseña de acceso a la base de datos (nunca usar credenciales de producción)
POSTGRES_PASSWORD=cambiar_esta_clave_postgres

# Puerto de conexión al servicio de PostgreSQL
DB_PORT=5432

# ── Redis (Caché y respuestas temporales — RC05, ADR-004) ────────────────────
# Puerto de conexión a la instancia en memoria de Redis
REDIS_PORT=6379

# Contraseña de autenticación requerida para conectar con Redis
REDIS_PASSWORD=cambiar_esta_clave_redis

# ── RabbitMQ (Mensajería y procesamiento asíncrono — RC06, ADR-004) ──────────
# Usuario de conexión al broker de mensajería RabbitMQ
RABBITMQ_USER=usuario_rabbit_falso

# Contraseña de conexión para el usuario de RabbitMQ
RABBITMQ_PASSWORD=cambiar_esta_clave_rabbitmq

# Virtual host (espacio de nombres) para aislar colas e intercambios en RabbitMQ
RABBITMQ_VHOST=/

# Puerto AMQP para la comunicación de mensajería con RabbitMQ
RABBITMQ_PORT=5672
